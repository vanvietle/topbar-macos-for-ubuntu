[Logo-menu]
custom-icon-path='@HOME@/.local/share/icons/custom/dino-trex-symbolic.svg'
menu-button-icon-image=5
menu-button-icon-size=26
show-activities-button=false
symbolic-icon=true
use-custom-icon=true

[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}, 'macbar_dark': {'name': <'MacBar dark'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_macbar_dark_blur'>, 'params': <{'radius': <30>, 'brightness': <0.69999999999999996>}>}>, <{'type': <'color'>, 'id': <'effect_macbar_dark_tint'>, 'params': <{'color': <[0.0, 0.0, 0.0, 0.20000000000000001]>}>}>]>}, 'macbar_light': {'name': <'MacBar light'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_macbar_light_blur'>, 'params': <{'radius': <30>, 'brightness': <1.0>}>}>, <{'type': <'color'>, 'id': <'effect_macbar_light_tint'>, 'params': <{'color': <[1.0, 1.0, 1.0, 0.55000000000000004]>}>}>]>}, 'macbar_clear': {'name': <'MacBar transparent'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_macbar_clear_blur'>, 'params': <{'radius': <1>, 'brightness': <1.0>}>}>]>}}
rounded-blur-found=false
settings-version=2

[blur-my-shell/appfolder]
blur=false
brightness=0.59999999999999998
sigma=30

[blur-my-shell/coverflow-alt-tab]
blur=false

[blur-my-shell/dash-to-dock]
blur=false
brightness=0.59999999999999998
sigma=30
static-blur=true
style-dash-to-dock=0

[blur-my-shell/hidetopbar]
compatibility=true

[blur-my-shell/lockscreen]
blur=false

[blur-my-shell/overview]
blur=false

[blur-my-shell/panel]
blur=true
brightness=0.59999999999999998
color=(0.0, 0.0, 0.0, 0.20000000000000001)
corner-radius=0
customize=true
noise-amount=0.0
override-background=true
pipeline='macbar_clear'
sigma=18

[blur-my-shell/popup]
blur=false

[blur-my-shell/screenshot]
blur=false

[blur-my-shell/window-list]
blur=false
brightness=0.59999999999999998
sigma=30

[globalmenu]
hide-overview-button=false
show-indicator=true
show-logo-menu=false

[hidetopbar]
enable-active-window=false
enable-intellihide=false
mouse-sensitive=true
pressure-threshold=1
show-in-overview=true

[just-perfection]
activities-button=false
clock-menu-position=1
panel-button-padding-size=8
panel-indicator-padding-size=4

[macbar]
autohide='off'
mode='dark'
text-color='#ffffff'
